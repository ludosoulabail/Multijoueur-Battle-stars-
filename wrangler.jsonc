{
  // Battle Stars — Worker + Durable Objects (serveur multijoueur autoritaire) + le jeu servi depuis ./public
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "battle-stars",
  "main": "index.js",
  "compatibility_date": "2026-11-16",

  // Le jeu (index.html, logos…) est servi tel quel ; seules les routes /api/* passent par le Worker
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },

  // Deux « classes » Durable Objects :
  //  - Matchmaker : un seul exemplaire mondial, il range les joueurs dans des parties
  //  - GameRoom   : une partie = un exemplaire, il fait tourner la simulation (game.js)
  "durable_objects": {
    "bindings": [
      { "name": "MATCH", "class_name": "Matchmaker" },
      { "name": "ROOMS", "class_name": "GameRoom" }
    ]
  },
  // SQLite obligatoire (seul type disponible sur le plan gratuit)
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Matchmaker", "GameRoom"] }
  ],

  "observability": { "enabled": true }
}
